<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact — ZenX</title>
<meta name="description" content="Get in touch with ZenX Limited — institutional inquiries, partner conversations, and document requests.">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%231B4332'/%3E%3Ctext x='50' y='68' font-family='serif' font-size='64' fill='%23D4B886' text-anchor='middle'%3EZ%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/style.css">
</head>
<body>

<!-- ========== HEADER ========== -->
<header class="site-header">
  <nav class="nav">
    <a href="index.html" class="logo">
      <span class="logo-mark">Z</span>
      <span>ZenX</span>
    </a>
    <div class="nav-links">
      <a href="index.html">Home</a>
      <a href="about.html">About</a>
      <a href="compliance.html">Compliance</a>
      <a href="index.html#adoption" class="is-rf">Platforms: RealFinance ↗</a>
      <a href="contact.html" class="is-active">Contact</a>
    </div>
    <a href="contact.html" class="nav-cta">Schedule a Briefing</a>
    <button class="nav-toggle" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<!-- ========== SUB HERO ========== -->
<section class="sub-hero">
  <div class="sub-hero-inner">
    <div class="eyebrow">— Contact</div>
    <h1>Let's have a <em>serious conversation</em>.</h1>
    <p class="lead">Whether you're an institutional allocator, an RWA platform exploring issuance, or a researcher studying the space — we'd like to hear from you.</p>
  </div>
</section>

<!-- ========== CONTACT FORM + INFO ========== -->
<section class="section">
  <div class="contact-grid">
    <form class="form" id="contact-form">
      <div class="form-success">
        ✓ Thank you. Your message has been received. We will be in touch within 2 business days.
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="firstName">First Name *</label>
          <input type="text" id="firstName" name="firstName" required>
        </div>
        <div class="form-group">
          <label for="lastName">Last Name *</label>
          <input type="text" id="lastName" name="lastName" required>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="email">Work Email *</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div class="form-group">
          <label for="organization">Organization *</label>
          <input type="text" id="organization" name="organization" required>
        </div>
      </div>

      <div class="form-group">
        <label for="inquiryType">Inquiry Type *</label>
        <select id="inquiryType" name="inquiryType" required>
          <option value="">— Select an option —</option>
          <option>Institutional Investor Briefing</option>
          <option>Partner Platform / RWA Issuance Inquiry</option>
          <option>Whitepaper / Document Request (NDA)</option>
          <option>Press &amp; Media</option>
          <option>Other</option>
        </select>
      </div>

      <div class="form-group">
        <label for="message">Message *</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>

      <div>
        <button type="submit" class="btn btn-primary">Send Message <span class="arrow">→</span></button>
      </div>

      <div class="form-help">By submitting, you agree to our processing your details for the purpose of responding to your inquiry. We do not share data with third parties.</div>
    </form>

    <aside class="contact-info">
      <h3>Direct Channels</h3>

      <div class="contact-info-item">
        <div class="label">Institutional Inquiries</div>
        <div class="value"><a href="mailto:institutional@zenx.io">institutional@zenx.io</a></div>
      </div>

      <div class="contact-info-item">
        <div class="label">Partner Platforms</div>
        <div class="value"><a href="mailto:partners@zenx.io">partners@zenx.io</a></div>
      </div>

      <div class="contact-info-item">
        <div class="label">Press &amp; Media</div>
        <div class="value"><a href="mailto:press@zenx.io">press@zenx.io</a></div>
      </div>

      <div class="contact-info-item">
        <div class="label">Entity</div>
        <div class="value">ZenX Limited · British Virgin Islands</div>
      </div>

      <div class="contact-info-item">
        <div class="label">Response Time</div>
        <div class="value">Within 2 business days</div>
      </div>

      <div class="mt-32" style="padding-top: 24px; border-top: 1px dashed var(--border); font-size: 13px; color: var(--ink-mute); line-height: 1.7;">
        Already using <a href="https://realfinance.app" target="_blank" rel="noopener" style="color: var(--green); border-bottom: 1px solid var(--gold);">RealFinance</a>? ZenX is the issuer of rFUIDL and rsFUIDL — questions about those products are best directed to the RealFinance team.
      </div>
    </aside>
  </div>
</section>

<!-- ========== FOOTER ========== -->
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div>
        <div class="footer-logo">ZenX</div>
        <div class="footer-tagline">Institutional token issuance &amp; asset anchoring infrastructure. Built for patient capital.</div>
      </div>
      <div class="footer-col">
        <div class="footer-col-title">The Firm</div>
        <ul>
          <li><a href="about.html">About</a></li>
          <li><a href="about.html#leadership">Leadership</a></li>
          <li><a href="compliance.html">Entity &amp; Jurisdiction</a></li>
          <li><a href="contact.html">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <div class="footer-col-title">Issuance</div>
        <ul>
          <li><a href="index.html#pillars">Token Issuance</a></li>
          <li><a href="index.html#pillars">Asset Anchoring</a></li>
          <li><a href="index.html#pillars">Redemption Undertaking</a></li>
          <li><a href="https://realfinance.app" target="_blank" rel="noopener" class="featured">Platforms: RealFinance</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <div class="footer-col-title">Resources</div>
        <ul>
          <li><a href="compliance.html#whitepaper">Whitepaper</a></li>
          <li><a href="compliance.html#agreement">Token Purchase Agreement</a></li>
          <li><a href="compliance.html">Compliance &amp; Governance</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div>© <span data-year>2026</span> ZenX Limited · BVI · All rights reserved.</div>
      <div>Tokens issued by ZenX are subject to the redemption undertaking set out in the Whitepaper.</div>
    </div>
  </div>
</footer>

<script src="assets/js/main.js"></script>
</body>
</html>
